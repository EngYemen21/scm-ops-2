{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "mobile:build": "vite build --config vite.mobile.config.js",
        "mobile:sync": "npm run mobile:build && cap sync",
        "mobile:android": "npm run mobile:sync && cap open android",
        "mobile:assets": "capacitor-assets generate --iconBackgroundColor \"#1E2130\" --iconBackgroundColorDark \"#1E2130\" --splashBackgroundColor \"#1E2130\" --splashBackgroundColorDark \"#1E2130\" --assetPath mobile/assets"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "puppeteer-core": "^25.11.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/app": "^8.1.1",
        "@capacitor/camera": "^8.2.4",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/ios": "^8.5.2",
        "@capacitor/keyboard": "^8.0.5",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@tanstack/vue-query": "^5.103.1",
        "html5-qrcode": "^2.3.8",
        "mapbox-gl": "^3.31.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^4.6.4"
    }
}
