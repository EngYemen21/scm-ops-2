  window       String?
  contact      String?
  address      String?
  plannedTime  String?
  actualTime   String?
  status       String    @default("pending")
  failReason   String?
  note         String?
  mapX         Float?
  mapY         Float?
  arrivedAt    DateTime?
  completedAt  DateTime?
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
