  receiverName String?
  deliveredQty Int?
  returnedQty  Int?
  gpsLat       Float?
  gpsLng       Float?
  gpsAccuracy  Float?
  gpsStatus    String    @default("unavailable")
  notes        String?
  failReason   String?
  at           DateTime  @default(now())
  createdById  String?

  delivery   DeliveryRecord? @relation(fields: [deliveryId], references: [id])
  trip       Trip            @relation(fields: [tripId], references: [id])
  stop       TripStop        @relation(fields: [stopId], references: [id])
  fo         FulfillmentOrder @relation(fields: [foId], references: [id])
  driver     Driver?         @relation(fields: [driverId], references: [id])
  vehicle    Vehicle?        @relation(fields: [vehicleId], references: [id])
  customer   Customer?       @relation(fields: [customerId], references: [id])
  attachments PodAttachment[]

  @@map("proof_of_delivery")
}

model PodAttachment {
  id         String   @id @default(cuid())
  podId      String
  kind       String
  fileName   String?
  mime       String?
  size       Int?
  storageKey String?
  url        String?
  status     String   @default("integration_pending")
  createdAt  DateTime @default(now())
  pod        ProofOfDelivery @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@map("pod_attachments")
}

// ───────────────────────────── Returns ─────────────────────────────
model ReturnOrder {
  id            String    @id @default(cuid())
  number        String    @unique
  type          String
  sourceAr      String?
  sourceEn      String?
  reference     String?
  customerId    String?
  supplierId    String?
  foId          String?
  tripId        String?
  warehouseId   String
  status        String    @default("pending")
  reasonCode    String?
  reasonAr      String?
  reasonEn      String?
  notes         String?
  attachments   String[]  @default([])
  decision      String?
  decidedById   String?
  decidedBy     String?
  decidedAt     DateTime?
  createdById   String?
  createdBy     String?
  approvedAt    DateTime?
  receivedAt    DateTime?
  inspectedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id])
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  fo         FulfillmentOrder? @relation(fields: [foId], references: [id])
  trip       Trip?      @relation(fields: [tripId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  lines      ReturnLine[]
  receiving  ReturnReceiving?
  inspection ReturnInspection?
  decisions  ReturnDecision[]

  @@index([status])
  @@map("returns")
}

model ReturnLine {
  id           String    @id @default(cuid())
  returnId     String
  lineNo       Int
  productId    String
  qty          Int
  batchNo      String?
  batchId      String?
  binId        String?
  expiryDate   DateTime?
  inspectedQty Int?
  condition    String?
  decision     String?
  ret          ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id])
  batch        Batch?      @relation(fields: [batchId], references: [id])
  bin          Bin?        @relation(fields: [binId], references: [id])

  @@unique([returnId, lineNo])
  @@map("return_lines")
}

model ReturnReceiving {
  returnId     String   @id
  receivedById String?
  receivedBy   String?
  receivedAt   DateTime @default(now())
  binCode      String?
  notes        String?
  ret          ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_receiving")
}

model ReturnInspection {
  returnId    String   @id
  inspectorId String?
  inspector   String?
  startedAt   DateTime @default(now())
  findings    String?
  ret         ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_inspections")
}

model ReturnDecision {
  id          String   @id @default(cuid())
  returnId    String
  decision    String
  qty         Int
  targetBinId String?
  movementId  String?
  decidedById String?
  decidedBy   String?
  note        String?
  at          DateTime @default(now())
  ret         ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_decisions")
}

// ───────────────────────────── Fleet operations ─────────────────────────────
model MaintenanceOrder {
  id        String    @id @default(cuid())
  number    String    @unique
  vehicleId String
  typeAr    String?
  typeEn    String?
  kind      String    @default("corrective")
  descAr    String?
  descEn    String?
  shop      String?
  startDate DateTime?
  endDate   DateTime?
  odometer  Int?
  cost      Float     @default(0)
  parts     Float     @default(0)
  labor     Float     @default(0)
  downDays  Int?
  downLabel String?
  nextKm    Int?
  status    String    @default("open")
  createdAt DateTime  @default(now())
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@map("maintenance_orders")
}

model FuelRecord {
  id        String   @id @default(cuid())
  number    String   @unique
  vehicleId String
  driverId  String?
  date      DateTime
  odometer  Int
  liters    Float
  cost      Float
  station   String?
  full      Boolean  @default(true)
  kmPerL    Float?
  costPerKm Float?
  anomaly   Boolean  @default(false)
  receipt   String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id])

  @@map("fuel_records")
}

model FleetAlert {
  id             String    @id @default(cuid())
  code           String    @unique
  category       String
  severity       String    @default("w")
  entityType     String?
  entityId       String?
  entityCode     String?
  textAr         String
  textEn         String?
  dueDate        String?
  owner          String?
  recommendAr    String?
  recommendEn    String?
  status         String    @default("open")
  snoozedUntil   DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@map("fleet_alerts")
}

model Incident {
  id        String   @id @default(cuid())
  driverId  String
  type      String
  date      DateTime
  desc      String
  severity  String   @default("low")
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@map("incidents")
}

model OpsRequest {
  id        String   @id @default(cuid())
  number    String   @unique
  type      String
  driverId  String?
  driverName String?
  vehicleCode String?
  tripNumber String?
  amount    Float    @default(0)
  desc      String
  location  String?
  attachment String?
  status    String   @default("submitted")
  createdAt DateTime @default(now())
  driver    Driver?  @relation(fields: [driverId], references: [id])

  @@map("ops_requests")
}

model DockAppointment {
  id          String   @id @default(cuid())
  number      String   @unique
  warehouseId String
  dock        String
  type        String
  reference   String
  date        DateTime
  slot        String
  carrier     String?
  createdAt   DateTime @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, dock, date, slot])
  @@map("dock_appointments")
}

model StaffAssignment {
  id          String   @id @default(cuid())
  warehouseId String
  who         String
  role        String
  zones       String?
  shift       String?
  fromDate    DateTime?
  cert        String?
  createdAt   DateTime @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("staff_assignments")
}

// ───────────────────────────── Operations platform ─────────────────────────────
model OpsException {
  id             String    @id @default(cuid())
  number         String    @unique
  kind           String
  severity       String    @default("w")
  status         String    @default("open")
  ownerRole      String?
  ownerUserId    String?
  slaHours       Float     @default(24)
  entityType     String?
  entityId       String?
  entityNumber   String?
  documentType   String?
  documentId     String?
  documentNumber String?
  textAr         String
  textEn         String?
  resolution     String?
  createdById    String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  events         ExceptionEvent[]

  @@index([status])
  @@index([entityType, entityId])
  @@map("exceptions")
}

model ExceptionEvent {
  id          String   @id @default(cuid())
  exceptionId String
  fromStatus  String?
  toStatus    String
  userId      String?
  username    String?
  note        String?
  at          DateTime @default(now())
  exception   OpsException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@map("exception_events")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  username      String?
  action        String
  entityType    String
  entityId      String?
  entityNumber  String?
  field         String?
  oldValue      String?
  newValue      String?
  requestId     String?
  transactionId String?
  ip            String?
  at            DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_logs")
}

model ActivityLog {
  id           String   @id @default(cuid())
  entityType   String?
  entityId     String?
  entityNumber String?
  textAr       String
  textEn       String?
  userId       String?
  username     String?
  at           DateTime @default(now())

  @@index([at])
  @@map("activity_logs")
}

model Notification {
  id           String   @id @default(cuid())
  roleKey      String?
  userId       String?
  textAr       String
  textEn       String?
  entityType   String?
  entityId     String?
  entityNumber String?
  read         Boolean  @default(false)
  at           DateTime @default(now())

  @@index([roleKey, read])
  @@map("notifications")
}

model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileName   String
  mime       String?
  size       Int?
  storageKey String?
  url        String?
  status     String   @default("integration_pending")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

model StatusHistory {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  userId     String?
  username   String?
  note       String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@map("status_history")
}

model SystemSetting {
  key         String   @id
  value       Json
  group       String   @default("general")
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model NumberSequence {
  key    String @id
  prefix String
  next   Int    @default(1)
  width  Int    @default(5)

  @@map("number_sequences")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  route          String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([userId, key, route])
  @@map("idempotency_keys")
}

model IntegrationEvent {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  status    String    @default("pending")
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@map("integration_events")
}
