// SCM OPS — relational schema (PostgreSQL). Every operational document is traceable end-to-end:
// PR → PR lines → RFQ → supplier quotations → PO → PO lines → inbound shipment → GRN → putaway → inventory movement
// SO → reservation → allocation → pick → pack → staging → trip → loading → dispatch → delivery → POD → return.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String?  @unique
  passwordHash       String
  nameAr             String
  nameEn             String
  initials           String?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles         UserRole[]
  warehouses    UserWarehouse[]
  refreshTokens RefreshToken[]
  driver        Driver?
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id       String  @id @default(cuid())
  key      String  @unique
  nameAr   String
  nameEn   String
  isSystem Boolean @default(true)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserWarehouse {
  userId      String
  warehouseId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────────── Product master ─────────────────────────────
model ProductCategory {
  id       String  @id @default(cuid())
  code     String  @unique
  nameAr   String
  nameEn   String
  parentId String?
  active   Boolean @default(true)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

model Uom {
  id     String @id @default(cuid())
  code   String @unique
  nameAr String
  nameEn String

  products Product[]
  barcodes ProductBarcode[]

  @@map("uoms")
}

enum StorageClass {
  ambient
  chilled
  frozen
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique
  nameAr          String
  nameEn          String
  brand           String?
  categoryId      String?
  baseUomId       String?
  storageClass    StorageClass @default(ambient)
  weightKg        Float        @default(0)
  unitsPerPallet  Int?
  purchasePrice   Decimal?     @db.Decimal(14, 2)
  tracksExpiry    Boolean      @default(false)
  reorderMin      Int          @default(0)
  reorderMax      Int?
  lengthCm        Float?
  widthCm         Float?
  heightCm        Float?
  volumeM3        Float?
  shelfLifeDays   Int?
  homeWarehouseId String?
  preferredSupplierName String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  baseUom        Uom?             @relation(fields: [baseUomId], references: [id])
  homeWarehouse  Warehouse?       @relation(fields: [homeWarehouseId], references: [id])
  barcodes       ProductBarcode[]
  suppliers      ProductSupplier[]
  storageReq     ProductStorageRequirement?
  batches        Batch[]
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  prLines        PrLine[]
  rfqLines       RfqLine[]
  sqLines        SupplierQuotationLine[]
  poLines        PoLine[]
  shipmentLines  ShipmentLine[]
  grnLines       GrnLine[]
  putawayTasks   PutawayTask[]
  quotationLines QuotationLine[]
  soLines        SalesOrderLine[]
  foLines        FoLine[]
  pickTasks      PickTask[]
  reservations   InventoryReservation[]
  allocations    InventoryAllocation[]
  transferLines  TransferLine[]
  countLines     CountLine[]
  returnLines    ReturnLine[]
  fixedBins      Bin[]

  @@index([categoryId])
  @@index([nameAr])
  @@map("products")
}

model ProductBarcode {
  id        String  @id @default(cuid())
  productId String
  barcode   String  @unique
  uomId     String?
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom       Uom?    @relation(fields: [uomId], references: [id])

  @@index([productId])
  @@map("product_barcodes")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  supplierSku String?
  price       Decimal? @db.Decimal(14, 2)
  leadDays    Int?
  preferred   Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model ProductStorageRequirement {
  productId    String       @id
  storageClass StorageClass
  minTempC     Float?
  maxTempC     Float?
  hazmat       Boolean      @default(false)
  notes        String?
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_storage_requirements")
}

// ───────────────────────────── Warehouse location model ─────────────────────────────
enum ZoneType {
  ambient
  chilled
  frozen
  hazmat
  quarantine
  staging
  damaged
  returns
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  city      String?
  type      String   @default("dc")
  areaM2    Float?
  docks     Int      @default(0)
  tempZones String   @default("all")
  hours     String?
  openDate  DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  zones        Zone[]
  bins         Bin[]
  users        UserWarehouse[]
  products     Product[]
  balances     InventoryBalance[]
  vehicles     Vehicle[]
  prs          PurchaseRequisition[]
  pos          PurchaseOrder[]
  rfqs         Rfq[]
  shipments    InboundShipment[]
  grns         GoodsReceipt[]
  putaways     PutawayTask[]
  salesOrders  SalesOrder[]
  fos          FulfillmentOrder[]
  pickLists    PickList[]
  transfersOut WarehouseTransfer[] @relation("TransferFrom")
  transfersIn  WarehouseTransfer[] @relation("TransferTo")
  counts       InventoryCount[]
  trips        Trip[]
  returns      ReturnOrder[]
  consolidations OrderConsolidation[]
  reservations InventoryReservation[]
  allocations  InventoryAllocation[]
  docks_       DockAppointment[]
  staff        StaffAssignment[]

  @@map("warehouses")
}

model Zone {
  id            String   @id @default(cuid())
  warehouseId   String
  code          String
  nameAr        String
  nameEn        String
  type          ZoneType @default(ambient)
  pickStrategy  String   @default("fefo")
  minTempC      Float?
  maxTempC      Float?
  capacityUnits Int?
  maxKg         Float?
  active        Boolean  @default(true)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  racks         Rack[]
  bins          Bin[]
  counts        InventoryCount[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Rack {
  id       String @id @default(cuid())
  zoneId   String
  aisle    Int
  rackNo   Int
  code     String
  levels   Int    @default(1)
  active   Boolean @default(true)
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bins     Bin[]

  @@unique([zoneId, code])
  @@map("racks")
}

enum BinStatus {
  active
  blocked
  full
  inactive
}

model Bin {
  id             String    @id @default(cuid())
  warehouseId    String
  zoneId         String
  rackId         String?
  code           String
  shelfNo        Int?
  type           String    @default("shelf")
  capacityUnits  Int?
  maxKg          Float?
  status         BinStatus @default(active)
  fixedProductId String?
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone           Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rack           Rack?     @relation(fields: [rackId], references: [id])
  fixedProduct   Product?  @relation(fields: [fixedProductId], references: [id])

  balances        InventoryBalance[]
  srcMovements    InventoryMovement[] @relation("MovementSrcBin")
  dstMovements    InventoryMovement[] @relation("MovementDstBin")
  suggestedPutaways PutawayTask[]     @relation("PutawaySuggestedBin")
  actualPutaways  PutawayTask[]       @relation("PutawayActualBin")
  shipmentLines   ShipmentLine[]
  pickTasks       PickTask[]
  allocations     InventoryAllocation[]
  transferFrom    TransferLine[]      @relation("TransferFromBin")
  transferTo      TransferLine[]      @relation("TransferToBin")
  countLines      CountLine[]
  returnLines     ReturnLine[]
  stagingEntries  StagingEntry[]

  @@unique([warehouseId, code])
  @@index([zoneId])
  @@map("bins")
}

// ───────────────────────────── Suppliers & customers ─────────────────────────────
model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  nameEn      String
  category    String?
  categoryEn  String?
  leadDays    Int      @default(5)
  otif        Float    @default(0)
  fillRate    Float    @default(0)
  score       Float    @default(70)
  ordersCount Int      @default(0)
  totalValue  Decimal  @default(0) @db.Decimal(16, 2)
  cr          String?
  vat         String?
  contact     String?
  email       String?
  terms       String?
  iban        String?
  minOrder    Decimal? @db.Decimal(14, 2)
  notes       String?
  isNew       Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  products   ProductSupplier[]
  quotations SupplierQuotation[]
  rfqs       RfqSupplier[]
  pos        PurchaseOrder[]
  shipments  InboundShipment[]
  grns       GoodsReceipt[]
  batches    Batch[]
  returns    ReturnOrder[]

  @@map("suppliers")
}

model Customer {
  id          String  @id @default(cuid())
  code        String  @unique
  nameAr      String
  nameEn      String
  city        String?
  zone        String?
  terms       String?
  creditLimit Decimal @default(0) @db.Decimal(14, 2)
  balance     Decimal @default(0) @db.Decimal(14, 2)
  contact     String?
  priceList   String?
  address     String?
  lat         Float?
  lng         Float?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  quotations Quotation[]
  orders     SalesOrder[]
  fos        FulfillmentOrder[]
  stops      TripStop[]
  pods       ProofOfDelivery[]
  returns    ReturnOrder[]

  @@map("customers")
}

// ───────────────────────────── Procurement ─────────────────────────────
model PurchaseRequisition {
  id            String   @id @default(cuid())
  number        String   @unique
  warehouseId   String
  requestedById String?
  requestedBy   String?
  needDate      DateTime?
  priority      String   @default("normal")
  justification String?
  costCenter    String?
  status        String   @default("draft")
  submittedAt   DateTime?
  approvedAt    DateTime?
  rfqId         String?
  poId          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  lines     PrLine[]
  approvals PrApproval[]
  rfqs      Rfq[]

  @@map("purchase_requisitions")
}

model PrLine {
  id        String  @id @default(cuid())
  prId      String
  lineNo    Int
  productId String
  qty       Int
  estPrice  Decimal? @db.Decimal(14, 2)
  notes     String?
  pr        PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([prId, lineNo])
  @@map("pr_lines")
}

model PrApproval {
  id         String    @id @default(cuid())
  prId       String
  step       Int
  roleKey    String
  approverId String?
  approver   String?
  decision   String    @default("pending")
  note       String?
  decidedAt  DateTime?
  pr         PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, step])
  @@map("pr_approvals")
}

model Rfq {
  id                  String    @id @default(cuid())
  number              String    @unique
  prId                String?
  closeDate           DateTime?
  invitedRule         String?
  terms               String?
  deliveryWarehouseId String?
  notes               String?
  status              String    @default("open")
  awardedQuotationId  String?   @unique
  awardedAt           DateTime?
  createdAt           DateTime  @default(now())

  pr         PurchaseRequisition? @relation(fields: [prId], references: [id])
  warehouse  Warehouse?           @relation(fields: [deliveryWarehouseId], references: [id])
  lines      RfqLine[]
  suppliers  RfqSupplier[]
  quotations SupplierQuotation[]
  awarded    SupplierQuotation?   @relation("RfqAwarded", fields: [awardedQuotationId], references: [id])
  pos        PurchaseOrder[]

  @@map("rfqs")
}

model RfqLine {
  id        String  @id @default(cuid())
  rfqId     String
  lineNo    Int
  productId String
  qty       Int
  rfq       Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([rfqId, lineNo])
  @@map("rfq_lines")
}

model RfqSupplier {
  rfqId      String
  supplierId String
  invitedAt  DateTime @default(now())
  rfq        Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([rfqId, supplierId])
  @@map("rfq_suppliers")
}

model SupplierQuotation {
  id             String    @id @default(cuid())
  number         String    @unique
  supplierId     String
  rfqId          String?
  supplierRef    String?
  date           DateTime  @default(now())
  validUntil     DateTime?
  paymentTerms   String?
  deliveryTerms  String?
  minOrder       Int       @default(0)
  leadDays       Int       @default(0)
  notes          String?
  attachmentName String?
  attachmentType String?
  recommended    Boolean   @default(false)
  score          Float?
  status         String    @default("received")
  createdAt      DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  rfq      Rfq?     @relation(fields: [rfqId], references: [id])
  awardedFor Rfq?   @relation("RfqAwarded")
  lines    SupplierQuotationLine[]

  @@map("supplier_quotations")
}

model SupplierQuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  qty         Int?
  price       Decimal @db.Decimal(14, 2)
  vatPct      Float   @default(15)
  leadDays    Int?
  quotation   SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("supplier_quotation_lines")
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  number       String    @unique
  supplierId   String
  warehouseId  String
  rfqId        String?
  status       String    @default("pending")
  total        Decimal   @default(0) @db.Decimal(16, 2)
  dueDate      DateTime?
  paymentTerms String?
  reference    String?
  notes        String?
  approvalStep Int       @default(0)
  openQty      Int       @default(0)
  createdById  String?
  createdBy    String?
  approvedAt   DateTime?
  sentAt       DateTime?
  confirmedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier  Supplier      @relation(fields: [supplierId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  rfq       Rfq?          @relation(fields: [rfqId], references: [id])
  lines     PoLine[]
  approvals PoApproval[]
  shipments InboundShipment[]
  grns      GoodsReceipt[]

  @@index([status])
  @@map("purchase_orders")
}

model PoLine {
  id          String  @id @default(cuid())
  poId        String
  lineNo      Int
  productId   String
  qty         Int
  price       Decimal @db.Decimal(14, 2)
  receivedQty Int     @default(0)
  damagedQty  Int     @default(0)
  rejectedQty Int     @default(0)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  shipmentLines ShipmentLine[]
  grnLines    GrnLine[]

  @@unique([poId, lineNo])
  @@map("po_lines")
}

model PoApproval {
  id         String    @id @default(cuid())
  poId       String
  step       Int
  roleKey    String
  labelAr    String
  labelEn    String
  approverId String?
  approver   String?
  decision   String    @default("pending")
  note       String?
  decidedAt  DateTime?
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@unique([poId, step])
  @@map("po_approvals")
}

// ───────────────────────────── Inbound: shipments, receiving, QC, GRN, putaway ─────────────────────────────
model InboundShipment {
  id                  String    @id @default(cuid())
  number              String    @unique
  poId                String
  supplierId          String
  warehouseId         String
  eta                 DateTime?
  status              String    @default("expected")
  arrivedAt           DateTime?
  inspectionStartedAt DateTime?
  completedAt         DateTime?
  locked              Boolean   @default(false)
  carrier             String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  po        PurchaseOrder @relation(fields: [poId], references: [id])
  supplier  Supplier      @relation(fields: [supplierId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  lines     ShipmentLine[]
  grns      GoodsReceipt[]
  putaways  PutawayTask[]

  @@index([status])
  @@map("inbound_shipments")
}

model ShipmentLine {
  id               String    @id @default(cuid())
  shipmentId       String
  lineNo           Int
  poLineId         String?
  productId        String
  orderedQty       Int
  acceptedQty      Int       @default(0)
  damagedQty       Int       @default(0)
  rejectedQty      Int       @default(0)
  batchNo          String?
  mfgDate          DateTime?
  expiryDate       DateTime?
  suggestedBinId   String?
  suggestionAr     String?
  suggestionEn     String?
  shipment         InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  poLine           PoLine?   @relation(fields: [poLineId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])
  suggestedBin     Bin?      @relation(fields: [suggestedBinId], references: [id])
  grnLines         GrnLine[]

  @@unique([shipmentId, lineNo])
  @@map("shipment_lines")
}

model GoodsReceipt {
  id           String   @id @default(cuid())
  number       String   @unique
  shipmentId   String
  poId         String
  supplierId   String
  warehouseId  String
  postedById   String?
  postedBy     String?
  postedAt     DateTime @default(now())
  summaryAr    String?
  summaryEn    String?
  transactionId String?

  shipment  InboundShipment @relation(fields: [shipmentId], references: [id])
  po        PurchaseOrder   @relation(fields: [poId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  lines     GrnLine[]
  putaways  PutawayTask[]

  @@map("goods_receipts")
}

model GrnLine {
  id             String    @id @default(cuid())
  grnId          String
  lineNo         Int
  shipmentLineId String?
  poLineId       String?
  productId      String
  receivedQty    Int
  acceptedQty    Int
  damagedQty     Int       @default(0)
  rejectedQty    Int       @default(0)
  remainingQty   Int       @default(0)
  batchNo        String?
  batchId        String?
  mfgDate        DateTime?
  expiryDate     DateTime?
  qcResult       String    @default("accepted")
  qcNote         String?
  qcById         String?
  qcAt           DateTime?
  grn            GoodsReceipt  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  shipmentLine   ShipmentLine? @relation(fields: [shipmentLineId], references: [id])
  poLine         PoLine?       @relation(fields: [poLineId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  batch          Batch?        @relation(fields: [batchId], references: [id])
  qcResults      QcResult[]
  putaways       PutawayTask[]

  @@unique([grnId, lineNo])
  @@map("grn_lines")
}

model QcResult {
  id          String   @id @default(cuid())
  grnLineId   String
  result      String
  qty         Int
  inspectorId String?
  inspector   String?
  notes       String?
  at          DateTime @default(now())
  grnLine     GrnLine  @relation(fields: [grnLineId], references: [id], onDelete: Cascade)

  @@map("qc_results")
}

model PutawayTask {
  id             String    @id @default(cuid())
  number         String    @unique
  grnId          String
  grnLineId      String
  shipmentId     String?
  productId      String
  batchId        String?
  batchNo        String?
  expiryDate     DateTime?
  qty            Int
  warehouseId    String
  suggestedBinId String?
  suggestionAr   String?
  suggestionEn   String?
  actualBinId    String?
  status         String    @default("open")
  confirmedById  String?
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())

  grn          GoodsReceipt    @relation(fields: [grnId], references: [id])
  grnLine      GrnLine         @relation(fields: [grnLineId], references: [id])
  shipment     InboundShipment? @relation(fields: [shipmentId], references: [id])
  product      Product         @relation(fields: [productId], references: [id])
  batch        Batch?          @relation(fields: [batchId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  suggestedBin Bin?            @relation("PutawaySuggestedBin", fields: [suggestedBinId], references: [id])
  actualBin    Bin?            @relation("PutawayActualBin", fields: [actualBinId], references: [id])

  @@index([status])
  @@map("putaway_tasks")
}

// ───────────────────────────── Inventory engine ─────────────────────────────
model Batch {
  id         String    @id @default(cuid())
  productId  String
  batchNo    String
  mfgDate    DateTime?
  expiryDate DateTime?
  supplierId String?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  balances    InventoryBalance[]
  movements   InventoryMovement[]
  grnLines    GrnLine[]
  putaways    PutawayTask[]
  allocations InventoryAllocation[]
  pickTasks   PickTask[]
  transferLines TransferLine[]
  countLines  CountLine[]
  returnLines ReturnLine[]

  @@unique([productId, batchNo])
  @@map("batches")
}

model InventoryBalance {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  binId       String
  batchId     String?
  batchKey    String   @default("")
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  allocated   Int      @default(0)
  quarantine  Boolean  @default(false)
  blocked     Boolean  @default(false)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bin       Bin       @relation(fields: [binId], references: [id])
  batch     Batch?    @relation(fields: [batchId], references: [id])

  @@unique([productId, binId, batchKey])
  @@index([warehouseId, productId])
  @@map("inventory_balances")
}

enum MovementType {
  opening
  grn
  stg
  putaway
  alloc
  pick
  pack
  load
  trf
  transit
  move
  ret
  restock
  adj
  dmg
  scrap
  qtn
  supret
}

model InventoryMovement {
  id              String       @id @default(cuid())
  number          String       @unique
  type            MovementType
  productId       String
  batchId         String?
  batchNo         String?
  qty             Int
  beforeQty       Int?
  afterQty        Int?
  srcWarehouseId  String?
  srcZoneId       String?
  srcRackId       String?
  srcBinId        String?
  dstWarehouseId  String?
  dstZoneId       String?
  dstRackId       String?
  dstBinId        String?
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  note            String?
  userId          String?
  username        String?
  transactionId   String?
  createdAt       DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
  srcBin  Bin?    @relation("MovementSrcBin", fields: [srcBinId], references: [id])
  dstBin  Bin?    @relation("MovementDstBin", fields: [dstBinId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([transactionId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id          String   @id @default(cuid())
  number      String   @unique
  soId        String
  soLineId    String
  productId   String
  warehouseId String
  qty         Int
  status      String   @default("active")
  createdAt   DateTime @default(now())
  releasedAt  DateTime?

  so        SalesOrder     @relation(fields: [soId], references: [id])
  soLine    SalesOrderLine @relation(fields: [soLineId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  allocations InventoryAllocation[]

  @@index([soId])
  @@map("inventory_reservations")
}

model InventoryAllocation {
  id            String   @id @default(cuid())
  reservationId String
  soLineId      String
  productId     String
  warehouseId   String
  binId         String
  batchId       String?
  qty           Int
  pickedQty     Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  reservation InventoryReservation @relation(fields: [reservationId], references: [id])
  soLine      SalesOrderLine       @relation(fields: [soLineId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  bin         Bin                  @relation(fields: [binId], references: [id])
  batch       Batch?               @relation(fields: [batchId], references: [id])

  @@index([soLineId])
  @@map("inventory_allocations")
}

model WarehouseTransfer {
  id              String    @id @default(cuid())
  number          String    @unique
  fromWarehouseId String
  toWarehouseId   String
  status          String    @default("draft")
  reasonCode      String?
  reasonAr        String?
  reasonEn        String?
  notes           String?
  requestedById   String?
  requestedBy     String?
  date            DateTime?
  eta             DateTime?
  approvedById    String?
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         TransferLine[]

  @@map("warehouse_transfers")
}

model TransferLine {
  id          String  @id @default(cuid())
  transferId  String
  lineNo      Int
  productId   String
  batchId     String?
  batchNo     String?
  qty         Int
  fromBinId   String
  toBinId     String?
  receivedQty Int?
  transfer    WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  batch       Batch?  @relation(fields: [batchId], references: [id])
  fromBin     Bin     @relation("TransferFromBin", fields: [fromBinId], references: [id])
  toBin       Bin?    @relation("TransferToBin", fields: [toBinId], references: [id])

  @@unique([transferId, lineNo])
  @@map("transfer_lines")
}

model InventoryCount {
  id          String    @id @default(cuid())
  number      String    @unique
  warehouseId String
  zoneId      String?
  type        String    @default("cycle")
  scope       String?
  blind       Boolean   @default(true)
  freeze      Boolean   @default(true)
  status      String    @default("open")
  counterId   String?
  counter     String?
  date        DateTime?
  approvedById String?
  adjustedAt  DateTime?
  createdAt   DateTime  @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  zone      Zone?     @relation(fields: [zoneId], references: [id])
  lines     CountLine[]

  @@map("inventory_counts")
}

model CountLine {
  id         String  @id @default(cuid())
  countId    String
  productId  String
  binId      String
  batchId    String?
  systemQty  Int
  countedQty Int?
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  bin        Bin     @relation(fields: [binId], references: [id])
  batch      Batch?  @relation(fields: [batchId], references: [id])

  @@map("count_lines")
}

model StagingEntry {
  id            String   @id @default(cuid())
  direction     String
  binId         String
  referenceType String
  referenceId   String
  referenceNumber String?
  qty           Int?
  status        String   @default("waiting")
  createdAt     DateTime @default(now())
  clearedAt     DateTime?
  bin           Bin      @relation(fields: [binId], references: [id])

  @@index([referenceType, referenceId])
  @@map("staging_entries")
}

// ───────────────────────────── Sales ─────────────────────────────
model Quotation {
  id          String    @id @default(cuid())
  number      String    @unique
  customerId  String
  date        DateTime  @default(now())
  validUntil  DateTime?
  status      String    @default("draft")
  terms       String?
  delivery    String?
  notes       String?
  createdById String?
  createdBy   String?
  soId        String?   @unique
  attachments String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  lines    QuotationLine[]
  so       SalesOrder? @relation(fields: [soId], references: [id])

  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  lineNo      Int
  productId   String
  qty         Int
  price       Decimal @db.Decimal(14, 2)
  discPct     Float   @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@unique([quotationId, lineNo])
  @@map("quotation_lines")
}

model SalesOrder {
  id              String    @id @default(cuid())
  number          String    @unique
  customerId      String
  warehouseId     String
  date            DateTime  @default(now())
  dueDate         DateTime?
  window          String?
  priority        String    @default("normal")
  status          String    @default("confirmed")
  kg              Float     @default(0)
  cbm             Float     @default(0)
  consolidationId String?
  tripId          String?
  createdById     String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer      Customer  @relation(fields: [customerId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  consolidation OrderConsolidation? @relation(fields: [consolidationId], references: [id])
  quotation     Quotation?
  lines         SalesOrderLine[]
  reservations  InventoryReservation[]
  fos           FulfillmentOrder[]
  stops         TripStop[]

  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(cuid())
  soId         String
  lineNo       Int
  productId    String
  qty          Int
  price        Decimal @db.Decimal(14, 2)
  discPct      Float   @default(0)
  reservedQty  Int     @default(0)
  allocatedQty Int     @default(0)
  pickedQty    Int     @default(0)
  deliveredQty Int     @default(0)
  returnedQty  Int     @default(0)
  so           SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
  reservations InventoryReservation[]
  allocations  InventoryAllocation[]
  foLines      FoLine[]

  @@unique([soId, lineNo])
  @@map("sales_order_lines")
}

model OrderConsolidation {
  id          String   @id @default(cuid())
  number      String   @unique
  warehouseId String
  rule        String?
  status      String   @default("open")
  createdById String?
  createdBy   String?
  tripId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  orders    SalesOrder[]
  trips     Trip[]

  @@map("order_consolidations")
}

// ───────────────────────────── Fulfillment ─────────────────────────────
model FulfillmentOrder {
  id          String    @id @default(cuid())
  number      String    @unique
  soId        String?
  customerId  String
  warehouseId String
  status      String    @default("alloc")
  seq         Int       @default(0)
  cartons     Int       @default(0)
  weightKg    Float     @default(0)
  cbm         Float     @default(0)
  zoneAr      String?
  zoneEn      String?
  tripId      String?
  loaded      Boolean   @default(false)
  loadedAt    DateTime?
  packedAt    DateTime?
  stagedAt    DateTime?
  dispatchedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  so        SalesOrder? @relation(fields: [soId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  trip      Trip?       @relation(fields: [tripId], references: [id])
  lines     FoLine[]
  pickLists PickList[]
  packages  Package[]
  tripOrders TripOrder[]
  loadingLines LoadingLine[]
  stops     TripStop[]
  deliveries DeliveryRecord[]
  pods      ProofOfDelivery[]
  returns   ReturnOrder[]

  @@index([status])
  @@map("fulfillment_orders")
}

model FoLine {
  id           String  @id @default(cuid())
  foId         String
  lineNo       Int
