model Trip {
  id              String    @id @default(cuid())
  number          String    @unique
  date            DateTime?
  warehouseId     String
  vehicleId       String?
  driverId        String?
  routeAr         String?
  routeEn         String?
  km              Float     @default(0)
  plannedStart    String?
  actualStart     DateTime?
  plannedEnd      String?
  actualEnd       DateTime?
  eta             String?
  delayMin        Int       @default(0)
  status          String    @default("planned")
  kg              Float     @default(0)
  cbm             Float     @default(0)
  pallets         Int       @default(0)
  tempNeed        String    @default("dry")
  consolidationId String?
  createdById     String?
  createdBy       String?
  dispatchedAt    DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver        Driver?   @relation(fields: [driverId], references: [id])
  consolidation OrderConsolidation? @relation(fields: [consolidationId], references: [id])
  stops         TripStop[]
  orders        TripOrder[]
