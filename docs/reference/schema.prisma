model Driver {
  id               String    @id @default(cuid())
  code             String    @unique
  userId           String?   @unique
  employeeNo       String?
  nameAr           String
  nameEn           String?
  nationality      String?
  mobile           String?
  licenseNo        String?
  licenseType      String?
  licenseExpiry    DateTime?
  iqamaExpiry      DateTime?
  medicalExpiry    DateTime?
  training         String?
  joinDate         DateTime?
  shift            String?
  shiftEn          String?
  weeklyHours      String?
  lastCheckin      DateTime?
  defaultVehicleId String?
  trips            Int       @default(0)
  deliveries       Int       @default(0)
  fails            Int       @default(0)
  okPct            Float     @default(100)
  ontimePct        Float     @default(100)
  avgDelay         String?
  km               Int       @default(0)
  rating           Float     @default(5)
  complaints       Int       @default(0)
  incidents        Int       @default(0)
  fuelScore        Float     @default(100)
  safety           Float     @default(100)
  state            String    @default("available")
  blocked          Boolean   @default(false)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id])
  defaultVehicle Vehicle?  @relation(fields: [defaultVehicleId], references: [id])
  tripsList      Trip[]
