  kind               String    @default("dry")
  typeAr             String?
  typeEn             String?
  tempRange          String?
  maxKg              Float     @default(0)
  maxCbm             Float     @default(0)
  pallets            Int       @default(0)
  compartments       Int       @default(1)
  odometer           Int       @default(0)
  engineHours        Int       @default(0)
  fuelType           String?
  tankL              Int?
  avgKmL             Float     @default(6)
  regExpiry          DateTime?
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  opCardExpiry       DateTime?
  lastMaintDate      DateTime?
  nextMaintDate      DateTime?
  nextMaintKm        Int?
  gpsDeviceId        String?
  telematicsProvider String?
  gpsOnline          Boolean   @default(false)
