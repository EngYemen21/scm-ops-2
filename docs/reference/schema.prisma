  status     String    @default("open")
  pickedById String?
  pickedBy   String?
  pickedAt   DateTime?
  pickList   PickList  @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  foLine     FoLine    @relation(fields: [foLineId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  bin        Bin       @relation(fields: [binId], references: [id])
  batch      Batch?    @relation(fields: [batchId], references: [id])

  @@map("pick_tasks")
}

model Package {
  id         String   @id @default(cuid())
  number     String   @unique
  foId       String
  cartons    Int      @default(1)
  weightKg   Float?
  volumeM3   Float?
  labelRef   String?
  packedById String?
  packedBy   String?
  packedAt   DateTime @default(now())
  fo         FulfillmentOrder @relation(fields: [foId], references: [id], onDelete: Cascade)

  @@map("packages")
}

// ───────────────────────────── Transportation ─────────────────────────────
model Vehicle {
  id                 String    @id @default(cuid())
  code               String    @unique
  plateAr            String
  plateEn            String?
