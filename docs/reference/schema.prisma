  @@map("fo_lines")
}

model PickList {
  id           String    @id @default(cuid())
  number       String    @unique
  warehouseId  String
  foId         String?
  status       String    @default("open")
  assignedToId String?
  assignedTo   String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  fo        FulfillmentOrder? @relation(fields: [foId], references: [id])
  tasks     PickTask[]

  @@map("pick_lists")
}

model PickTask {
  id         String    @id @default(cuid())
  pickListId String
  foLineId   String
  seq        Int       @default(0)
  productId  String
  binId      String
  batchId    String?
  batchNo    String?
  qty        Int
