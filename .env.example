APP_NAME="B2B ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scm_ops
DB_USERNAME=scm
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_ROTATION_GRACE_MS=60000
SEED_PASSWORD=

# ---- Integrations (all optional; empty = honest "integration_pending", nothing is sent) ----
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_PUBLIC_URL=
WIALON_BASE_URL=
WIALON_TOKEN=
GPS_PROVIDER_URL=
GPS_PROVIDER_TOKEN=
MAPBOX_PUBLIC_TOKEN=
MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_TEMPLATE_LANG=
SMTP_URL=
SMTP_FROM=
ERP_BASE_URL=
ERP_TOKEN=
B2B_WEBHOOK_URL=
B2B_WEBHOOK_TOKEN=

# B2B Integration Layer (docs/integration/RUNBOOK.md). Off until a system is enabled AND has a key.
# Keys are "keyId:secret" pairs, comma-separated (two during a rotation). Generate a secret with:
#   php -r "echo bin2hex(random_bytes(32));"
INTEGRATION_SALES_ENABLED=false
INTEGRATION_KEYS_SALES=
INTEGRATION_SALES_EVENTS_URL=
INTEGRATION_SALES_CYCLE_URL=
INTEGRATION_SALES_RECONCILE_URL=
INTEGRATION_SCHEDULER_ENABLED=false
INTEGRATION_KEYS_SCHEDULER=
INTEGRATION_DEFAULT_WAREHOUSE=RYD
INTEGRATION_OPPORTUNISTIC_SECONDS=120
