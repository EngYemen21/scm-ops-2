# Not needed by the deployed function (vendor/ is installed by the PHP runtime from composer.lock).
/.git
/.github
/node_modules
/vendor
/tests
/docs
/docker
/tools
/database/seed-data
/storage/logs
/storage/framework
/.env
/.env.*
!/.env.example

# native app projects are not part of the web deployment. Anchored with "/": an unanchored "mobile" also matched
# resources/js/layout/mobile/ (the phone layout) and broke every web build.
/android
/ios
/mobile
